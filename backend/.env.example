# Copier en .env pour le développement local.

# SQLite — fichier local, aucune infra à installer pour faire tourner le projet.
DATABASE_URL="file:./dev.db"

# Secret de signature des tokens de session (JWT). À générer aléatoirement en prod
# (ex: `openssl rand -hex 32`) — jamais la valeur d'exemple ci-dessous.
JWT_SECRET="change-me-in-every-environment"
# CLAUDE.md : sessions courtes pour les comptes internes.
JWT_EXPIRES_IN="2h"

PORT=4000
# Origine autorisée pour le CORS — l'app front en dev (Vite). Port fixé à 5175
# (voir frontend/vite.config.ts) pour éviter un glissement de port silencieux
# si un autre projet occupe déjà 5173 sur la machine.
CORS_ORIGIN="http://localhost:5175"
# Origine de l'app front — sert à construire les liens envoyés par email (invitation, signature).
FRONTEND_BASE_URL="http://localhost:5175"

# Dossier de stockage des fichiers uploadés (PDF, photos). Jamais servi en accès
# statique direct — toujours via un endpoint authentifié et autorisé.
UPLOAD_DIR="./uploads"

# Provider d'envoi OTP. "console" journalise le code côté serveur (dev/démo) sans
# l'exposer au client. "smtp" envoie un vrai email (voir SMTP_* ci-dessous).
OTP_PROVIDER="console"

# Provider des emails "métier" (invitation de compte, lien de signature) —
# indépendant de OTP_PROVIDER. "console" (défaut) ou "smtp".
EMAIL_PROVIDER="console"

# Configuration SMTP — requise uniquement si OTP_PROVIDER et/ou EMAIL_PROVIDER
# valent "smtp". Fonctionne avec n'importe quel fournisseur SMTP standard
# (Brevo, Gmail via mot de passe d'application, etc.).
# Exemple Brevo (ex-Sendinblue) : SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587,
# SMTP_USER = ton identifiant SMTP Brevo, SMTP_PASS = ta clé SMTP Brevo
# (Campagnes > SMTP & API > SMTP, PAS ton mot de passe de compte).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SignSecure TrustFlow <no-reply@signsecure.demo>"

# Durée de validité du lien de signature à usage unique (CLAUDE.md § Sign).
SIGNER_LINK_EXPIRY_HOURS=48

# Verrouillage de compte après N tentatives de connexion échouées.
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15

# Expiration de session après inactivité (minutes), contrôlée côté serveur.
SESSION_IDLE_MINUTES=15

# --- OTP de signature par SMS (canal distinct de l'email qui reçoit le lien) ---
# "simulation" (défaut) : aucun SMS réel, le message est journalisé côté serveur
# avec la mention SIMULATION. "twilio" : envoi réel via l'API Twilio.
SMS_PROVIDER="simulation"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Numéro expéditeur Twilio au format international, ex. +15005550006
TWILIO_FROM=""
# Indicatif ajouté aux numéros saisis sans "+" (229 = Bénin).
DEFAULT_PHONE_COUNTRY_CODE=229

# --- Chiffrement des fichiers au repos (AES-256-GCM) ---
# 64 caractères hex. Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sans clé, les fichiers restent en clair (avertissement au démarrage).
# Ne jamais changer cette clé une fois des fichiers chiffrés : ils deviendraient illisibles.
FILE_ENCRYPTION_KEY=""

# --- Cachet de plateforme PAdES (auto-signé, DÉMONSTRATION, NON QUALIFIÉ) ---
# Généré automatiquement au premier démarrage s'il n'existe pas. Dossier keys/ ignoré par git.
SEAL_P12_PATH="./keys/cachet-demo.p12"
SEAL_P12_PASSPHRASE="change-me"

# --- Horodatage par un tiers (RFC 3161) — ACTIVÉ par défaut ---
# Seule preuve de date qu'un serveur compromis ne peut pas refaire. Seule
# l'empreinte SHA-256 est envoyée, jamais le document. Vide = désactivé.
TSA_URL="https://freetsa.org/tsr"

# Secret des jetons de page imprimés dans les QR (aperçu page par page).
# Générer comme JWT_SECRET ; à défaut, dérivé de JWT_SECRET.
PAGE_TOKEN_SECRET=""

# Domaine imprimé en clair sous le QR des PDF signés (ancre contre les faux sites de vérification).
PUBLIC_VERIFY_BASE_URL="http://localhost:5175"

# --- Tâches planifiées ---
SCHEDULER_ENABLED=true
# Relance email du signataire quand il reste moins de N heures avant expiration du lien.
SIGNER_REMINDER_HOURS_BEFORE_EXPIRY=24
# Envoi du dernier hash du journal d'audit aux superviseurs/administrateurs.
AUDIT_ANCHOR_INTERVAL_HOURS=24
